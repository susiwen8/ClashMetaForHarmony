{
  "schemaVersion": "1.0.0",
  "target": {
    "name": "HarmonyOS 6/API 20/arm64",
    "targetSdkVersion": "6.1.1(24)",
    "targetApiVersion": 24,
    "compatibleSdkVersion": "6.0.0(20)",
    "compatibleApiVersion": 20,
    "runtimeOS": "HarmonyOS",
    "architecture": "arm64"
  },
  "env": {
    "sdkRoots": [
      "DEVECO_SDK_HOME",
      "HARMONY_SDK_HOME",
      "OHOS_SDK_HOME",
      "HOS_SDK_HOME",
      "DEVECO_HOME_SDK"
    ]
  },
  "defaults": {
    "sdkRoots": [
      "/Applications/DevEco-Studio.app/Contents/sdk/default"
    ],
    "devecoContentsRoots": [
      "/Applications/DevEco-Studio.app/Contents"
    ],
    "versionProbeTimeoutMs": 5000
  },
  "tools": {
    "node": {
      "versionCommands": []
    },
    "java": {
      "versionCommands": [
        ["--version"],
        ["-version"]
      ]
    }
  },
  "files": {
    "localProperties": "harmony/local.properties",
    "sdkPkg": "sdk-pkg.json",
    "devecoProductInfo": "Resources/product-info.json",
    "etsPackage": "openharmony/ets/oh-uni-package.json",
    "nativePackage": "openharmony/native/oh-uni-package.json",
    "toolchainsPackage": "openharmony/toolchains/oh-uni-package.json",
    "arktsDeclarationRoots": [
      "openharmony/ets/api",
      "hms/ets/api"
    ],
    "ndkSysroot": "openharmony/native/sysroot",
    "ndkCmake": "openharmony/native/build/cmake/ohos.toolchain.cmake",
    "nativeCmakeBinary": "openharmony/native/build-tools/cmake/bin/cmake",
    "clang": "openharmony/native/llvm/bin/aarch64-unknown-linux-ohos-clang",
    "llvmReadelf": "openharmony/native/llvm/bin/llvm-readelf",
    "hdc": "openharmony/toolchains/hdc",
    "hvigorPackage": "tools/hvigor/hvigor/package.json",
    "hvigorBinary": "tools/hvigor/bin/hvigorw",
    "ohpmPackage": "tools/ohpm/package.json",
    "ohpmBinary": "tools/ohpm/bin/ohpm",
    "nativeLibraryDirectory": "openharmony/native/sysroot/usr/lib/aarch64-linux-ohos"
  }
}
